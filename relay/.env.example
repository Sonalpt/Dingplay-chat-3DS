# Copy to .env (or export in your shell) before `npm start`.

# Path to a Firebase service-account JSON for project dingplay-e3401.
# Firebase console → Project settings → Service accounts → Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Firebase Web API key (Project settings → General → Web API Key).
# Used only for POST /auth/login (Identity Toolkit signInWithPassword).
FIREBASE_WEB_API_KEY=

# Storage bucket for voice / drawing uploads (same one the mobile app uses).
FIREBASE_STORAGE_BUCKET=dingplay-e3401.firebasestorage.app

# Random string used to sign console session tokens. Rotating it signs everyone out.
RELAY_SECRET=change-me-to-a-long-random-string

# HTTP port. The console talks plain HTTP to this port; put TLS termination in
# front of it (nginx / Caddy / a cloud LB) only if you also keep an HTTP port
# open for consoles — the 3DS httpc stack cannot negotiate modern TLS.
PORT=8080

# Optional: path to an ffmpeg binary. When present, 3DS voice notes are also
# transcoded to m4a so the mobile app can play them, and mobile AAC voice notes
# are transcoded to ADPCM for the console. Without it, voice is 3DS↔3DS only.
FFMPEG_PATH=ffmpeg

# Optional: where downscaled avatars and transcoded audio are cached on disk.
CACHE_DIR=./cache
