# systemd unit for the Dingplay Chat relay (Node).
#
#   rsync relay/ to /opt/dingplay-chat/relay, `npm ci --omit=dev` there
#   put .env + serviceAccount.json in /etc/dingplay-relay (root:dingplay, 640)
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin dingplay
#   sudo mkdir -p /var/lib/dingplay-relay/cache && sudo chown -R dingplay:dingplay /var/lib/dingplay-relay
#   sudo cp relay/dingplay-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dingplay-relay
#   journalctl -u dingplay-relay -f

[Unit]
Description=Dingplay Chat relay (3DS <-> Firebase)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dingplay
Group=dingplay
WorkingDirectory=/opt/dingplay-chat/relay
EnvironmentFile=/etc/dingplay-relay/.env
ExecStart=/usr/bin/node src/server.js

# Port 8000 (set in .env): the console speaks plain HTTP (no modern TLS on a 3DS).
# 80 would be friendlier to hotspots, but on the shared box the 3LWO relay's iptables
# NAT owns 80/443/8080/8443/993/2053. CAP_NET_BIND_SERVICE kept so moving below
# 1024 later is only an .env change.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

# Same sandbox as the 3LWO relay on this box, plus one writable dir for the media cache.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dingplay-relay
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK/AF_UNIX: Node enumerates interfaces at start (os.networkInterfaces) and libuv uses unix sockets internally.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

# firebase-admin idles around 100 MB; anything near this is a leak, not load.
MemoryMax=384M
TasksMax=128

[Install]
WantedBy=multi-user.target
